# =========================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (SUPABASE + FASTIFY)
# =========================================================================

# Porta do servidor Fastify
PORT=3333
HOST=0.0.0.0

# SUPABASE POSTGRESQL CONNECTION STRINGS
# Obtenha em: Supabase Dashboard > Project Settings > Database > Connection String

# 1. Modo Transaction Pooler (Porta 6543) - Recomendado para produção / Serverless:
DATABASE_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Modo Direct Connection (Porta 5432) - Necessário para migrações Prisma:
DIRECT_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# URLs de Integração
PAGBANK_SACOLA_URL="https://sacola.pagbank.com.br/7f90fb8d-0ea8-44f9-b11f-b73ca1e192c6"
GOOGLE_FORMS_RESPONSE_URL="https://docs.google.com/forms/d/e/1FAIpQLSdqNGkkPI3t3RMG3p52te3z68oAIR5cYRvKf8OOPrJbqpBtbA/formResponse"
